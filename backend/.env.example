ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/anicraze_erp
# Local development only. Production requires STORAGE_BACKEND=volume and an
# absolute STORAGE_ROOT mounted on durable, independently backed-up storage.
STORAGE_BACKEND=local
STORAGE_ROOT=
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true
SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ISSUER=anicraze-erp-api
JWT_AUDIENCE=anicraze-erp-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
EXPOSE_DEV_RESET_TOKEN=false
ENABLE_AUTH_TEST_ROUTES=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
MULTI_WAREHOUSE_ENABLED=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=development
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_INVOICE_TEMPLATE_NAME=anicraze_invoice_v1
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_MAX_ATTEMPTS=3
MAIL_ENABLED=false
MAIL_PROVIDER=smtp
MAIL_FROM=reports@anicraze.example
OWNER_REPORT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
LARGE_STOCK_ADJUSTMENT_THRESHOLD=20

# Optional local-only accounts created by app.scripts.seed_owner.
SEED_LOCAL_DEMO_USERS=false
LOCAL_OWNER_PASSWORD=
LOCAL_MANAGER_PASSWORD=
LOCAL_ACCOUNTANT_PASSWORD=
LOCAL_INVENTORY_PASSWORD=
LOCAL_SALES_PASSWORD=
LOCAL_HR_PASSWORD=
